{%- comment -%}
  AJ Bargain Bin — a taste of the weekly bin, on the homepage.

  READS THE COLLECTION, NOT THE METAOBJECT. The app writes real prices and a
  `bargain-bin` tag; a tag-matched collection turns that into something Liquid
  can page through. Nothing here needs to know when the week rotates, which
  means this section cannot fall out of step with the app — if the bin is empty
  the section disappears rather than advertising an empty shelf.

  SHOWS THE SAVING RATHER THAN ASSERTING IT. Every price is computed from the
  variant's own compare-at, so a product that already carried a supplier MSRP
  displays its true, larger saving instead of a flat "25% off" that would be
  wrong for about half the bin. That is also why the heading says "at least".
{%- endcomment -%}

{%- liquid
  assign bin = collections[section.settings.collection_handle]
  assign limit = section.settings.products_shown | plus: 0
-%}

{%- if bin != blank and bin.products_count > 0 -%}
  <div
    class="aj-bin color-{{ section.settings.color_scheme }} section spacing-style"
    style="{% render 'spacing-style', settings: section.settings %}"
  >
    <div class="page-width">
      <div class="aj-bin__head">
        <div>
          {%- if section.settings.heading != blank -%}
            <h2 class="aj-bin__heading">{{ section.settings.heading | escape }}</h2>
          {%- endif -%}
          {%- if section.settings.subheading != blank -%}
            <p class="aj-bin__subheading">{{ section.settings.subheading | escape }}</p>
          {%- endif -%}
        </div>
        <a class="aj-bin__all" href="{{ bin.url }}">
          See all {{ bin.products_count }} &rarr;
        </a>
      </div>

      <ul class="aj-bin__grid" role="list">
        {%- for product in bin.products limit: limit -%}
          {%- liquid
            assign v = product.selected_or_first_available_variant
            assign saving = 0
            if v.compare_at_price > v.price
              assign saving = v.compare_at_price | minus: v.price | times: 100 | divided_by: v.compare_at_price | round
            endif
          -%}
          <li class="aj-bin__item">
            <a class="aj-bin__tile" href="{{ product.url }}">
              <span class="aj-bin__media">
                {%- if product.featured_media -%}
                  {{
                    product.featured_media
                    | image_url: width: 600
                    | image_tag:
                      loading: 'lazy',
                      sizes: '(min-width: 750px) 25vw, 45vw',
                      widths: '200, 300, 400, 600',
                      class: 'aj-bin__image',
                      alt: product.title
                  }}
                {%- endif -%}
                {%- if saving > 0 -%}
                  <span class="aj-bin__badge">{{ saving }}% off</span>
                {%- endif -%}
              </span>
              <span class="aj-bin__name">{{ product.title | escape }}</span>
              <span class="aj-bin__prices">
                <span class="aj-bin__price">{{ v.price | money }}</span>
                {%- if saving > 0 -%}
                  <s class="aj-bin__was">{{ v.compare_at_price | money }}</s>
                {%- endif -%}
              </span>
              {%- comment -%}
                Reads the per-product measurement, not the vendor shape. A bin
                item that also ships free is the strongest card in the grid and
                the tile had no way to say so.
              {%- endcomment -%}
              {%- assign bin_ship = product.metafields.ship.cost.value -%}
              {%- if bin_ship != blank and bin_ship == 0 -%}
                <span class="aj-card-free">Ships free</span>
              {%- endif -%}
            </a>
          </li>
        {%- endfor -%}
      </ul>
    </div>
  </div>
{%- elsif request.design_mode -%}
  <div class="aj-bin aj-bin--empty page-width">
    <p>
      <strong>The Bargain Bin is empty.</strong>
      It fills when the app rotates a week — check that
      <code>BARGAIN_BIN_ENABLED</code> is set and that a
      <code>{{ section.settings.collection_handle }}</code> collection exists.
    </p>
  </div>
{%- endif -%}

{{ 'aj-ships-free.css' | asset_url | stylesheet_tag }}

{% stylesheet %}
  .aj-bin__head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: var(--padding-md, 1.5rem);
  }

  .aj-bin__heading { margin: 0 0 0.25rem; }
  .aj-bin__subheading { margin: 0; opacity: 0.75; }

  .aj-bin__all {
    flex: none;
    font-weight: 600;
    text-decoration: none;
    color: inherit;
    white-space: nowrap;
  }

  .aj-bin__all:hover { text-decoration: underline; }

  .aj-bin__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--padding-md, 1.5rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media screen and (min-width: 750px) {
    .aj-bin__grid { grid-template-columns: repeat(auto-fill, minmax(14rem, 1fr)); }
  }

  /* Same card treatment as Shop by category, deliberately: supplier photography
     is just as uneven here, and two different card styles in one scroll reads as
     a bug rather than as variety. */
  .aj-bin__item { display: flex; }

  .aj-bin__tile {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    width: 100%;
    color: inherit;
    text-decoration: none;
  }

  .aj-bin__media {
    position: relative;
    display: block;
    aspect-ratio: 1;
    overflow: hidden;
    box-sizing: border-box;
    padding: 8%;
    border-radius: var(--aj-cats-radius, 8px);
    background: rgb(var(--color-foreground-rgb) / 0.04);
    box-shadow: inset 0 0 0 1px rgb(var(--color-foreground-rgb) / 0.1);
  }

  .aj-bin__image {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
    transition: transform 0.3s ease;
  }

  .aj-bin__tile:hover .aj-bin__image,
  .aj-bin__tile:focus-visible .aj-bin__image { transform: scale(1.03); }

  .aj-bin__badge {
    position: absolute;
    top: 0.5rem;
    left: 0.5rem;
    padding: 0.2rem 0.5rem;
    border-radius: 999px;
    font-size: 0.75rem;
    font-weight: 700;
    /* Solid, not the old 0.9 alpha. That opacity existed to soften a black chip
       against a photo; a yellow one washes out through it and loses the contrast
       the ink text depends on. Ink on solid yellow is 11.17:1 over any image. */
    background: var(--aj-price-accent, rgb(var(--color-foreground-rgb) / 0.9));
    color: var(--aj-price-on-accent, rgb(var(--color-background-rgb, 255 255 255)));
  }

  .aj-bin__name { font-weight: 600; line-height: 1.25; }

  .aj-bin__prices {
    margin-top: auto;
    display: flex;
    align-items: baseline;
    gap: 0.4rem;
    font-size: 0.9375rem;
  }

  .aj-bin__price { font-weight: 700; }
  .aj-bin__was { opacity: 0.6; }

  .aj-bin--empty { padding-block: var(--padding-xl, 3rem); text-align: center; }

  @media (prefers-reduced-motion: reduce) {
    .aj-bin__image { transition: none; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "AJ Bargain Bin",
  "tag": "section",
  "settings": [
    {
      "type": "paragraph",
      "content": "Shows products the app has priced into the Bargain Bin. Rotates weekly on its own; nothing to set here when the week changes."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The Bargain Bin"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Everything at least 25% off. New picks every week."
    },
    {
      "type": "text",
      "id": "collection_handle",
      "label": "Collection handle",
      "default": "bargain-bin",
      "info": "Must match the collection the app maintains."
    },
    {
      "type": "range",
      "id": "products_shown",
      "label": "Products shown",
      "min": 2,
      "max": 24,
      "step": 1,
      "default": 8
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 32
    }
  ],
  "presets": [
    {
      "name": "AJ Bargain Bin"
    }
  ]
}
{% endschema %}
