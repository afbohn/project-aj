{%- comment -%}
  AJ Shop by Category — the second way to browse, after price.

  DELIBERATELY NOT BY SUPPLIER. A shopper who reads a maker's name can search it
  and buy direct; on a dropship catalogue that is handing away the sale.
  Category keeps the browsing here.

  Built on Shopify's standard product taxonomy rather than productType, which
  suppliers fill with whatever they like — a third of this catalogue reads
  "Ceramic". The taxonomy is populated on about 92% of products and is a real
  hierarchy, so its top segment gives clean groupings we did not have to invent.
  Only the top segment is used: the full paths run five deep
  ("Apparel & Accessories > Clothing Accessories > Hats > Fedoras"), which is
  precise and useless as navigation.

  Discovers the `cat-*` collections that scripts/categories.py maintains, so a
  category appears here on its own as the catalogue grows rather than by editing
  a theme setting.

  Image-led, unlike the price bands: a band has no representative image, but a
  category does — and the thing itself is what someone is deciding about.
{%- endcomment -%}

{%- liquid
  assign prefix = 'cat-'
  assign min_products = section.settings.min_products | plus: 0
  assign max_cats = section.settings.max_cats | plus: 0

  comment
    Count first so an empty section renders nothing rather than a bare heading.
  endcomment
  assign renderable = 0
  for collection in collections
    if collection.handle contains prefix and collection.all_products_count >= min_products
      assign renderable = renderable | plus: 1
    endif
  endfor
-%}

{%- if renderable > 0 -%}
  <div
    class="aj-cats color-{{ section.settings.color_scheme }} section spacing-style"
    style="{% render 'spacing-style', settings: section.settings %}"
  >
    <div class="page-width">
      {%- if section.settings.heading != blank -%}
        <h2 class="aj-cats__heading">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
      {%- if section.settings.subheading != blank -%}
        <p class="aj-cats__subheading">{{ section.settings.subheading | escape }}</p>
      {%- endif -%}

      <ul class="aj-cats__grid" role="list">
        {%- assign shown = 0 -%}
        {%- for collection in collections -%}
          {%- unless collection.handle contains prefix -%}
            {%- continue -%}
          {%- endunless -%}
          {%- if collection.all_products_count < min_products -%}
            {%- continue -%}
          {%- endif -%}
          {%- if shown >= max_cats -%}
            {%- break -%}
          {%- endif -%}
          {%- assign shown = shown | plus: 1 -%}

          {%- comment -%}
            Category collections are created by rule and carry no image of
            their own, so borrow the first product's — it shows what is actually
            in there, which is the decision being made.
          {%- endcomment -%}
          {%- assign cover = collection.image -%}
          {%- unless cover -%}
            {%- assign cover = collection.products.first.featured_media.preview_image -%}
          {%- endunless -%}

          <li class="aj-cats__item">
            <a class="aj-cats__tile" href="{{ collection.url }}">
              <span class="aj-cats__media">
                {%- if cover -%}
                  {{
                    cover
                    | image_url: width: 600
                    | image_tag:
                      loading: 'lazy',
                      sizes: '(min-width: 750px) 25vw, 45vw',
                      widths: '200, 300, 400, 600',
                      class: 'aj-cats__image',
                      alt: collection.title
                  }}
                {%- endif -%}
              </span>
              <span class="aj-cats__name">{{ collection.title | escape }}</span>
              <span class="aj-cats__count">
                {{ collection.all_products_count }}
                {%- if collection.all_products_count == 1 %} item{% else %} items{% endif -%}
              </span>
            </a>
          </li>
        {%- endfor -%}
      </ul>
    </div>
  </div>
{%- elsif request.design_mode -%}
  <div class="aj-cats aj-cats--empty page-width">
    <p>
      <strong>No category collections yet.</strong>
      These appear automatically once the catalogue sync has created a
      <code>cat-*</code> collection for each category.
    </p>
  </div>
{%- endif -%}

{% stylesheet %}
  .aj-cats__heading {
    margin: 0 0 0.25rem;
  }

  .aj-cats__subheading {
    margin: 0 0 var(--padding-md, 1.5rem);
    opacity: 0.75;
  }

  .aj-cats__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--padding-md, 1.5rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media screen and (min-width: 750px) {
    .aj-cats__grid {
      grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr));
    }
  }

  .aj-cats__tile {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    color: inherit;
    text-decoration: none;
  }

  .aj-cats__media {
    display: block;
    aspect-ratio: 1;
    overflow: hidden;
    border-radius: 3px;
    background: rgb(var(--color-foreground-rgb) / 0.06);
  }

  .aj-cats__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.3s ease;
  }

  .aj-cats__tile:hover .aj-cats__image,
  .aj-cats__tile:focus-visible .aj-cats__image {
    transform: scale(1.03);
  }

  .aj-cats__name {
    font-weight: 600;
    line-height: 1.25;
  }

  .aj-cats__count {
    font-size: 0.8125rem;
    opacity: 0.7;
  }

  .aj-cats--empty {
    padding-block: var(--padding-xl, 3rem);
    text-align: center;
  }

  @media (prefers-reduced-motion: reduce) {
    .aj-cats__image { transition: none; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "AJ Shop by Category",
  "tag": "section",
  "settings": [
    {
      "type": "paragraph",
      "content": "Lists the cat-* collections built from Shopify's standard product taxonomy. New categories appear here on their own."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop by category"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "A bit of everything. Have a dig."
    },
    {
      "type": "range",
      "id": "max_cats",
      "label": "Categories shown",
      "min": 2,
      "max": 24,
      "step": 1,
      "default": 8
    },
    {
      "type": "range",
      "id": "min_products",
      "label": "Minimum products to show a category",
      "min": 1,
      "max": 10,
      "step": 1,
      "default": 2,
      "info": "Hides categories with barely anything in them."
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 32
    }
  ],
  "presets": [
    {
      "name": "AJ Shop by Category"
    }
  ]
}
{% endschema %}
