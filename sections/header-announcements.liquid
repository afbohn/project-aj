{% if section.blocks.size > 1 %}
  <script
    src="{{ 'announcement-bar.js' | asset_url }}"
    type="module"
    fetchpriority="low"
  ></script>
{% endif %}

{% render 'contrast-override', background_color: section.settings.background_color, section_id: section.id %}

<div class="section-background color-custom-{{ section.id }}"></div>
<aside
  class="announcement-bar spacing-style section section--{{ section.settings.section_width }} color-custom-{{ section.id }}"
  style="{% render 'spacing-padding', settings: section.settings %}; --border-bottom-width: {{ section.settings.divider_width }}px;{% if section.settings.divider_color != blank %} --color-border: {{ section.settings.divider_color }};{% endif %}"
>
  {% liquid
    assign autoplay = false
    assign show_arrows = false
    if section.blocks.size > 1
      assign autoplay = true
      assign show_arrows = true
    endif
  %}

  <announcement-bar-component
    class="announcement-bar__slider"
    {% if autoplay == true %}
      autoplay="{{ section.settings.speed }}" aria-live="polite"
    {% endif %}
  >
    {% if show_arrows %}
      {% render 'slideshow-arrows', icon_style: 'chevron' %}
    {% endif %}

    <div class="announcement-bar__slides">
      {%- comment -%}
        Today's Yoink, first. Rendered here rather than as a block in
        sections/header-group.json because that file is owned by the theme
        editor — edits to it in the repo were not applied to the live theme,
        while section liquid syncs reliably.

        The most-seen strip on the site said "Welcome to our store", which tells
        a visitor nothing. On a store whose whole proposition is one deal a day,
        it should name the deal and link to it. Resolves the live deal itself, so
        it rotates at midnight with nothing to edit, and falls through to the
        configured blocks when no deal is running rather than announcing one that
        does not exist.
      {%- endcomment -%}
      {%- liquid
        assign now = 'now' | date: '%s' | plus: 0
        assign deal = null
        for entry in shop.metaobjects.daily_deal.values
          assign starts = entry.starts_at.value | date: '%s' | plus: 0
          assign ends = entry.ends_at.value | date: '%s' | plus: 0
          if starts <= now and ends > now
            assign deal = entry
            break
          endif
        endfor
        assign deal_product = deal.product.value
        assign deal_variant = deal_product.selected_or_first_available_variant
        assign deal_anchor = deal_variant.compare_at_price
        if deal_anchor == blank or deal_anchor <= deal_variant.price
          assign deal_anchor = null
        endif
        if deal_anchor
          assign deal_off = deal_anchor | minus: deal_variant.price | times: 100 | divided_by: deal_anchor
        endif
      -%}

      {%- if deal_product != blank -%}
        <a class="aj-announce" href="{{ deal_product.url }}">
          <span class="aj-announce__label">Today's Yoink</span>
          {%- comment -%}
            The SAVING leads and the product follows. A supplier's product name is
            the least persuasive thing in this strip and it was the widest; the
            number is the reason anyone clicks.
          {%- endcomment -%}
          {%- if deal_off -%}
            <span class="aj-announce__save">{{ deal_off }}% off</span>
          {%- endif -%}
          <span class="aj-announce__go" aria-hidden="true">&rarr;</span>
        </a>
      {%- else -%}
        {% content_for 'blocks' %}
      {%- endif -%}
    </div>
  </announcement-bar-component>
</aside>

{% stylesheet %}
  /*
    A STRIP, NOT A SENTENCE. This was black text on white at 14px — the same
    weight as a cookie notice, for the one line telling every visitor what the
    entire store is about.

    Ink ground with yellow rather than a yellow ground: the header below it is
    already teal, and two loud colours stacked fight each other. Dark reads as a
    banner and lets the number carry the colour. Yellow on ink is 11.17:1 and
    white on ink 14.7:1, so both clear AA comfortably.
  */
  .aj-announce {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    flex-wrap: wrap;
    justify-content: center;
    color: #ffffff;
    text-decoration: none;
    font-size: 0.9375rem;
    line-height: 1.25;
    /*
      0.3rem, not 0.55rem. The bar measured 40px tall: 22px of "53% off" plus
      17.6px of padding. A sticky bar sits above every page on the site, so its
      height is subtracted from the first screen of every one of them — 40px for
      three short words was more than it had earned.
    */
    padding-block: 0.3rem;
  }

  .aj-announce:hover .aj-announce__save,
  .aj-announce:focus-visible .aj-announce__save {
    text-decoration: underline;
  }

  .aj-announce__label {
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-size: 0.75rem;
    color: var(--aj-brand-yellow, #ffe000);
  }

  /* The loudest thing in the strip, because it is the only thing in it that
     makes anybody click. */
  .aj-announce__save {
    font-weight: 800;
    /* The tallest element in the bar, so it sets the bar's height. 1rem rather
       than 1.0625rem: still the loudest thing here at weight 800 in yellow,
       without being what makes the bar thick. */
    font-size: 1rem;
    letter-spacing: -0.01em;
    color: var(--aj-brand-yellow, #ffe000);
  }

  .aj-announce__go {
    color: var(--aj-brand-yellow, #ffe000);
    transition: transform 0.15s ease;
  }
  .aj-announce:hover .aj-announce__go { transform: translateX(2px); }

  @media screen and (max-width: 749px) {
    /* The title is the least useful part on a narrow bar — the label and the
       saving already say "there is a deal, tap here". */
  }

  @media (prefers-reduced-motion: reduce) {
    .aj-announce__go { transition: none; }
  }

  .announcement-bar {
    border-block-end: var(--border-bottom-width) solid var(--color-border);
  }

  .announcement-bar__slider {
    display: flex;
    flex-direction: row;
    align-items: center;
    position: relative;

    @media screen and (max-width: 749px) {
      grid-column: 1 / -1;
    }
  }

  .announcement-bar__slides {
    display: grid;
    grid: [stack] auto / [stack] auto;
    width: calc(100% - var(--button-size) * 2);
    max-width: 680px;
    margin-inline: auto;
  }

  .announcement-bar__slides > * {
    grid-area: stack;
  }

  .announcement-bar__slide {
    transition: opacity 0.5s ease-in-out, visibility 0.5s ease-in-out;
    content-visibility: visible;

    &[aria-hidden='true'] {
      opacity: 0;
      visibility: hidden;
    }
  }

  .announcement-bar__slider slideshow-arrows {
    padding: 0;
    mix-blend-mode: normal;
  }

  .announcement-bar__slider slideshow-arrows .slideshow-control {
    color: var(--color-foreground);
  }

  .announcement-bar__slider .slideshow-control {
    display: flex;
    padding: 0;
    width: var(--button-size);
    height: var(--button-size);
    align-items: center;
    justify-content: center;
    opacity: 1;
    animation: none;

    @media screen and (min-width: 750px) {
      --slideshow-control-offset: calc((var(--button-size) - var(--icon-size-xs)) / 2);

      .section--page-width &.slideshow-control--previous {
        transform: translateX(var(--slideshow-control-offset));
      }
    }
  }

  .announcement-bar__slider .slideshow-control .svg-wrapper {
    width: var(--icon-size-xs);
    height: var(--icon-size-xs);
  }

  .announcement-bar__slide {
    place-content: center;
  }

  .announcement-bar__text:first-child {
    margin: 0;
  }

  .announcement-bar__link {
    position: absolute;
    inset: 0;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.announcement_bar",
  "blocks": [
    {
      "type": "_announcement"
    }
  ],
  "enabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "range",
      "id": "speed",
      "label": "t:settings.scroll_speed",
      "min": 2,
      "max": 10,
      "default": 5,
      "unit": "sec"
    },
    {
      "type": "header",
      "content": "t:content.appearance"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "t:settings.section_width",
      "options": [
        {
          "value": "page-width",
          "label": "t:options.page"
        },
        {
          "value": "full-width",
          "label": "t:options.full"
        }
      ],
      "default": "page-width"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "placeholder": "t:settings.default"
    },
    {
      "type": "range",
      "id": "divider_width",
      "label": "t:settings.divider_thickness",
      "min": 0,
      "max": 5,
      "step": 0.5,
      "unit": "px",
      "default": 0
    },
    {
      "type": "color",
      "id": "divider_color",
      "label": "t:settings.divider_color",
      "placeholder": "t:settings.default",
      "visible_if": "{{ section.settings.divider_width > 0 }}"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 15
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 15
    }
  ],
  "presets": [
    {
      "name": "t:names.announcement_bar",
      "blocks": {
        "announcement_1": {
          "type": "_announcement"
        }
      },
      "block_order": ["announcement_1"]
    }
  ]
}
{% endschema %}
