      "label": "Top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "shoe", "label": "Shoe" },
            { "value": "cart-add", "label": "Add to cart" },
            { "value": "register", "label": "Cash register" },
            { "value": "discount-tag", "label": "Discount tag" },
            { "value": "box", "label": "Box" },
            { "value": "clipboard", "label": "Clipboard" },
            { "value": "lock", "label": "Lock" },
            { "value": "star", "label": "Star" },
            { "value": "heart", "label": "Heart" },
            { "value": "truck", "label": "Truck" },
            { "value": "return", "label": "Return" },
            { "value": "ruler", "label": "Ruler" },
            { "value": "leather", "label": "Leather" },
            { "value": "stopwatch", "label": "Stopwatch" },
            { "value": "eye", "label": "Eye" }
          ],
          "default": "shoe"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Step"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text"
        }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "TWX Redemption Welcome",
      "category": "Storefront",
      "blocks": [
        {
          "type": "step",
          "settings": {
            "icon": "shoe",
