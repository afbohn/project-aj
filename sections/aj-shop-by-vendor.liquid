{%- comment -%}
  AJ Shop by Maker — browse by supplier.

  The second useful navigation axis after price. Supplier categories from
  Collective are unusable as a taxonomy ("Ceramic" for a third of the catalogue),
  but the supplier NAME is clean, meaningful, and something a shopper can form a
  preference about — someone who liked the pottery wants more of that pottery.

  Discovers the `vendor-*` collections that scripts/vendors.py and the app's
  catalogue sync maintain, rather than taking a hand-picked list. A new supplier
  therefore appears here on its own once its collection exists, which is the
  point: the catalogue grows by import, not by editing a theme setting.

  Unlike the price bands these tiles are image-led. A price band has no
  representative image, but a maker does — the thing they make is exactly what
  someone is deciding about.
{%- endcomment -%}

{%- liquid
  assign prefix = 'vendor-'
  assign min_products = section.settings.min_products | plus: 0
  assign max_makers = section.settings.max_makers | plus: 0

  comment
    Count first so an empty section renders nothing rather than a bare heading.
  endcomment
  assign renderable = 0
  for collection in collections
    if collection.handle contains prefix and collection.all_products_count >= min_products
      assign renderable = renderable | plus: 1
    endif
  endfor
-%}

{%- if renderable > 0 -%}
  <div
    class="aj-makers color-{{ section.settings.color_scheme }} section spacing-style"
    style="{% render 'spacing-style', settings: section.settings %}"
  >
    <div class="page-width">
      {%- if section.settings.heading != blank -%}
        <h2 class="aj-makers__heading">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
      {%- if section.settings.subheading != blank -%}
        <p class="aj-makers__subheading">{{ section.settings.subheading | escape }}</p>
      {%- endif -%}

      <ul class="aj-makers__grid" role="list">
        {%- assign shown = 0 -%}
        {%- for collection in collections -%}
          {%- unless collection.handle contains prefix -%}
            {%- continue -%}
          {%- endunless -%}
          {%- if collection.all_products_count < min_products -%}
            {%- continue -%}
          {%- endif -%}
          {%- if shown >= max_makers -%}
            {%- break -%}
          {%- endif -%}
          {%- assign shown = shown | plus: 1 -%}

          {%- comment -%}
            Vendor collections are created by rule and carry no image of their
            own, so borrow the first product's — it shows what this maker
            actually makes, which is the decision being made.
          {%- endcomment -%}
          {%- assign cover = collection.image -%}
          {%- unless cover -%}
            {%- assign cover = collection.products.first.featured_media.preview_image -%}
          {%- endunless -%}

          <li class="aj-makers__item">
            <a class="aj-makers__tile" href="{{ collection.url }}">
              <span class="aj-makers__media">
                {%- if cover -%}
                  {{
                    cover
                    | image_url: width: 600
                    | image_tag:
                      loading: 'lazy',
                      sizes: '(min-width: 750px) 25vw, 45vw',
                      widths: '200, 300, 400, 600',
                      class: 'aj-makers__image',
                      alt: collection.title
                  }}
                {%- endif -%}
              </span>
              <span class="aj-makers__name">{{ collection.title | escape }}</span>
              <span class="aj-makers__count">
                {{ collection.all_products_count }}
                {%- if collection.all_products_count == 1 %} item{% else %} items{% endif -%}
              </span>
            </a>
          </li>
        {%- endfor -%}
      </ul>
    </div>
  </div>
{%- elsif request.design_mode -%}
  <div class="aj-makers aj-makers--empty page-width">
    <p>
      <strong>No maker collections yet.</strong>
      These appear automatically once the catalogue sync has created a
      <code>vendor-*</code> collection for each supplier.
    </p>
  </div>
{%- endif -%}

{% stylesheet %}
  .aj-makers__heading {
    margin: 0 0 0.25rem;
  }

  .aj-makers__subheading {
    margin: 0 0 var(--padding-md, 1.5rem);
    opacity: 0.75;
  }

  .aj-makers__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--padding-md, 1.5rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media screen and (min-width: 750px) {
    .aj-makers__grid {
      grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr));
    }
  }

  .aj-makers__tile {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    color: inherit;
    text-decoration: none;
  }

  .aj-makers__media {
    display: block;
    aspect-ratio: 1;
    overflow: hidden;
    border-radius: 3px;
    background: rgb(var(--color-foreground-rgb) / 0.06);
  }

  .aj-makers__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.3s ease;
  }

  .aj-makers__tile:hover .aj-makers__image,
  .aj-makers__tile:focus-visible .aj-makers__image {
    transform: scale(1.03);
  }

  .aj-makers__name {
    font-weight: 600;
    line-height: 1.25;
  }

  .aj-makers__count {
    font-size: 0.8125rem;
    opacity: 0.7;
  }

  .aj-makers--empty {
    padding-block: var(--padding-xl, 3rem);
    text-align: center;
  }

  @media (prefers-reduced-motion: reduce) {
    .aj-makers__image { transition: none; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "AJ Shop by Maker",
  "tag": "section",
  "settings": [
    {
      "type": "paragraph",
      "content": "Lists the vendor-* collections kept in step by the catalogue sync. New suppliers appear here on their own."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop by maker"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Independent makers, one order at a time."
    },
    {
      "type": "range",
      "id": "max_makers",
      "label": "Makers shown",
      "min": 2,
      "max": 24,
      "step": 1,
      "default": 8
    },
    {
      "type": "range",
      "id": "min_products",
      "label": "Minimum products to show a maker",
      "min": 1,
      "max": 10,
      "step": 1,
      "default": 2,
      "info": "Hides suppliers we only carry one thing from."
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 32
    }
  ],
  "presets": [
    {
      "name": "AJ Shop by Maker"
    }
  ]
}
{% endschema %}
