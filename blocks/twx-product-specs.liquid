{%- comment -%}
  TWX Product Specs — Horizon theme block.
  Renders the Twisted X spec metafields (the content the legacy ocs-v2-pdp PDP showed)
  as a labeled list. Add it to the product page via the theme editor (Product page →
  add block → "TWX Product Specs"), or in templates/product.json under the
  product-information section's blocks.

  Reads these metafields (backfill them first — Collective does not import metafields;
  see scripts/backfill-metafields.mjs):
    global.comfort_technology
    custom.toe_safety, custom.additional_safety_features, custom.toe_shape,
    custom.heel_type, custom.outsole_composition, custom.colorway, custom.closure_type,
    custom.footwear_construction_features

  Only non-blank rows render. Install at: blocks/twx-product-specs.liquid in the theme.
{%- endcomment -%}

{%- liquid
  assign p = closest.product
  assign mf = p.metafields
-%}

<div
  class="twx-specs spacing-style"
  style="{% render 'spacing-style', settings: block.settings %}"
  {{ block.shopify_attributes }}
>
  {% if block.settings.heading != blank %}
    <p class="twx-specs__heading">{{ block.settings.heading | escape }}</p>
  {% endif %}

  <dl class="twx-specs__list">
    {%- capture rows -%}
      {%- if mf.global.comfort_technology != blank -%}<row label="Comfort Technology">{{ mf.global.comfort_technology.value | replace: '|', ', ' }}</row>{%- endif -%}
      {%- if mf.custom.toe_safety != blank -%}<row label="Toe Safety">{{ mf.custom.toe_safety.value | replace: '|', ', ' }}</row>{%- endif -%}
      {%- if mf.custom.additional_safety_features != blank -%}<row label="Safety">{{ mf.custom.additional_safety_features.value | replace: '|', ', ' }}</row>{%- endif -%}
      {%- if mf.custom.toe_shape != blank -%}<row label="Toe Shape">{{ mf.custom.toe_shape.value }}</row>{%- endif -%}
      {%- if mf.custom.heel_type != blank -%}<row label="Heel Type">{{ mf.custom.heel_type.value }}</row>{%- endif -%}
      {%- if mf.custom.outsole_composition != blank -%}<row label="Outsole">{{ mf.custom.outsole_composition.value }}</row>{%- endif -%}
      {%- if mf.custom.closure_type != blank -%}<row label="Closure Type">{{ mf.custom.closure_type.value }}</row>{%- endif -%}
      {%- if mf.custom.colorway != blank -%}<row label="Color">{{ mf.custom.colorway.value }}</row>{%- endif -%}
      {%- if mf.custom.footwear_construction_features != blank -%}<row label="Construction">{{ mf.custom.footwear_construction_features.value | newline_to_br }}</row>{%- endif -%}
    {%- endcapture -%}

    {%- comment -%} Render the captured pseudo-rows into <dt>/<dd> pairs {%- endcomment -%}
    {%- assign parts = rows | split: '<row label="' -%}
    {%- for part in parts -%}
      {%- if part contains '">' -%}
        {%- assign label = part | split: '">' | first -%}
        {%- assign value = part | split: '">' | last | split: '</row>' | first -%}
        {%- if value != blank -%}
          <dt class="twx-specs__label">{{ label }}</dt>
          <dd class="twx-specs__value">{{ value }}</dd>
        {%- endif -%}
      {%- endif -%}
    {%- endfor -%}
  </dl>
</div>

{% stylesheet %}
  .twx-specs__heading {
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    margin: 0 0 var(--padding-sm);
  }
  .twx-specs__list {
    display: grid;
    grid-template-columns: max-content 1fr;
    gap: var(--padding-2xs) var(--padding-md);
    margin: 0;
  }
  .twx-specs__label {
    font-weight: 600;
    color: rgb(var(--color-foreground-rgb) / var(--opacity-subdued-text));
  }
  .twx-specs__value { margin: 0; }
{% endstylesheet %}

{% schema %}
{
  "name": "TWX Product Specs",
  "tag": "twx-product-specs",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Specifications" },
    { "type": "header", "content": "Padding" },
    { "type": "range", "id": "padding-block-start", "label": "Top", "min": 0, "max": 100, "step": 1, "unit": "px", "default": 16 },
    { "type": "range", "id": "padding-block-end", "label": "Bottom", "min": 0, "max": 100, "step": 1, "unit": "px", "default": 16 },
    { "type": "range", "id": "padding-inline-start", "label": "Left", "min": 0, "max": 100, "step": 1, "unit": "px", "default": 0 },
    { "type": "range", "id": "padding-inline-end", "label": "Right", "min": 0, "max": 100, "step": 1, "unit": "px", "default": 0 }
  ],
  "presets": [
    { "name": "TWX Product Specs", "category": "Product" }
  ]
}
{% endschema %}
