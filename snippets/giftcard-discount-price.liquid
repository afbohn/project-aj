{%- comment -%}
  Gift card discount price (product pages).

  When a visitor unlocked the store with a PERCENTAGE code, show what this
  product costs with their discount:

      MSRP  $159.95   (struck through)
      $119.97 with your discount

  The rate comes from `txgc_gate_config` — the code's giftcard/gate metafield
  (v1), fetched by the worker and stored by giftcard-gate.liquid. The gift card
  app publishes it to an ORDINARY namespace precisely so other apps can read it;
  the Function's own configuration lives in a private app-reserved namespace and
  is unreadable from here.

  Shape: {v, type, rate, amount, freeShipping, wholeCart, minSubtotal,
          collectionIds, collectionHandles}

  A price printed here is a promise about checkout, so every branch below fails
  CLOSED — anything unrecognised, unreadable or ambiguous renders nothing and
  leaves the theme's own prices untouched.

  Five things that are easy to get wrong, all deliberate:

  1. ceil, not round. Checkout rounds the DISCOUNT down, so 159.95 × 25% =
     39.9875 becomes 39.98 and the customer is charged 119.97. Math.round on the
     final price gives 119.96 — a cent low, which is a wrong price, not a
     rounding preference.

  2. `rate` is null on non-percentage cards, and `type`/`freeShipping` are
     INDEPENDENT. A full-ride card is type "percentage" AND freeShipping true.
     Branching on type alone would suppress the product discount on most cards.

  3. collectionIds non-empty while collectionHandles is empty means the scope
     cannot be resolved (e.g. the collection was deleted). Treating that as "no
     restriction" would show a discount on every product for a scoped code.

  4. wholeCart false means the Function discounts a single unit of a single
     line. So this is only true while the cart is empty, or holds exactly this
     variant — see cartAllows(). item_count > 1 is NOT sufficient: one unit of a
     DIFFERENT product is item_count 1, but adding this one makes two lines and
     only one gets discounted.

  5. minSubtotal must be met by this item alone, since the cart holds at most
     this one item.
{%- endcomment -%}
{%- if settings.gate_enabled and template.name == 'product' and product != blank -%}
  <style>
    /* Applied to the theme's own <product-price> element. Kept on the element
       (not its children) so it survives the inner re-render that fires on every
       variant change. */
    .txgc-msrp .price,
    .txgc-msrp .compare-at-price {
      text-decoration: line-through;
      opacity: 0.65;
    }

    .txgc-msrp::before {
      content: 'MSRP';
      display: block;
      font-size: 0.6875rem;
      font-weight: 600;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      text-decoration: none;
      opacity: 0.7;
    }

    .txgc-yourprice {
      display: block;
      margin-top: 0.35rem;
    }

    .txgc-yourprice__amount {
      font-size: 1.375rem;
      font-weight: 700;
      color: #941114;
    }

    .txgc-yourprice__note {
      margin-inline-start: 0.4rem;
      font-size: 0.8125rem;
      font-weight: 600;
      letter-spacing: 0.02em;
      color: #941114;
    }
  </style>

  <script>
    (function () {
      var CONFIG_KEY = 'txgc_gate_config';

      var PRICES = {{ product.variants | map: 'price' | json }};
      var VARIANT_IDS = {{ product.variants | map: 'id' | json }};
      var CURRENCY = {{ cart.currency.iso_code | json }};
      var PRODUCT_COLLECTIONS = [
        {%- for c in product.collections -%}
          {{ c.handle | json }}{%- unless forloop.last -%},{%- endunless -%}
        {%- endfor -%}
      ];

      var priceById = {};
      for (var i = 0; i < VARIANT_IDS.length; i++) {
        priceById[String(VARIANT_IDS[i])] = PRICES[i];
      }

      var cfg = null;
      try {
        cfg = JSON.parse(localStorage.getItem(CONFIG_KEY));
      } catch (e) {}

      // Refuse a shape we do not understand rather than misreading it.
      if (!cfg || cfg.v !== 1) return;

      // Rule 2: the product discount hinges on `rate`, independently of `type`
      // and `freeShipping`. A free-shipping-only card has rate null and must
      // not touch product prices.
      var rate = typeof cfg.rate === 'number' ? cfg.rate : null;
      if (rate === null || !isFinite(rate) || rate <= 0 || rate > 100) return;

      // Rule 4 (config half): a whole-cart discount would need different maths
      // than "this line". None exist today; refuse rather than assume.
      if (cfg.wholeCart) return;

      // Rule 3: scope declared but unresolvable — we cannot tell whether this
      // product is covered, so say nothing.
      var ids = Array.isArray(cfg.collectionIds) ? cfg.collectionIds : [];
      var handles = Array.isArray(cfg.collectionHandles) ? cfg.collectionHandles : [];
      if (ids.length && !handles.length) return;

      // Scoped code: this product must be in one of the covered collections.
      if (handles.length) {
        var covered = false;
        for (var h = 0; h < handles.length; h++) {
          if (PRODUCT_COLLECTIONS.indexOf(handles[h]) !== -1) {
            covered = true;
            break;
          }
        }
        if (!covered) return;
      }

      var fmt;
      try {
        fmt = new Intl.NumberFormat(document.documentElement.lang || 'en-US', {
          style: 'currency',
          currency: CURRENCY
        });
      } catch (e) {
        return;
      }

      // Cart snapshot, taken once. Evaluated per variant at render time because
      // the shopper can switch variants after the page loads.
      var cart = null;

      function cartAllows(variantId) {
        if (!cart || typeof cart.item_count !== 'number') return false;
        if (cart.item_count === 0) return true;
        return (
          cart.item_count === 1 &&
          cart.items &&
          cart.items[0] &&
          String(cart.items[0].variant_id) === String(variantId)
        );
      }

      function currentVariantId() {
        var input = document.querySelector(
          'product-form-component input[name="id"], form[action*="/cart/add"] input[name="id"]'
        );
        if (input && input.value) return String(input.value);
        var param = new URLSearchParams(window.location.search).get('variant');
        if (param) return String(param);
        return VARIANT_IDS.length ? String(VARIANT_IDS[0]) : null;
      }

      function teardown(host) {
        host.classList.remove('txgc-msrp');
        var stale = host.parentNode && host.parentNode.querySelector(':scope > .txgc-yourprice');
        if (stale && stale.parentNode) stale.parentNode.removeChild(stale);
      }

      function render(host) {
        var id = currentVariantId();
        var cents = id ? priceById[id] : null;

        // Any reason we cannot stand behind the number: remove it. This runs on
        // every variant change, so a switch into a disallowed state clears a
        // figure that is already on screen.
        if (
          cents == null ||
          !cartAllows(id) ||
          (typeof cfg.minSubtotal === 'number' && cents < cfg.minSubtotal)
        ) {
          teardown(host);
          return;
        }

        // Rule 1: checkout floors the discount, so the price the customer pays
        // is the ceiling of price - discount. Done in integer cents throughout.
        var discount = Math.floor((cents * rate) / 100);
        var discounted = cents - discount;

        host.classList.add('txgc-msrp');

        var line = host.parentNode.querySelector(':scope > .txgc-yourprice');
        if (!line) {
          line = document.createElement('span');
          line.className = 'txgc-yourprice';
          line.innerHTML =
            '<span class="txgc-yourprice__amount"></span>' +
            '<span class="txgc-yourprice__note">with your discount</span>';
          host.parentNode.insertBefore(line, host.nextSibling);
        }
        line.querySelector('.txgc-yourprice__amount').textContent = fmt.format(discounted / 100);
      }

      function start() {
        // The main product price. Card prices are intentionally out of scope for
        // now — product pages first.
        var host = document.querySelector('product-price');
        if (!host || !host.parentNode) return;

        render(host);

        // The theme replaces the inner markup of <product-price> on every
        // variant change, which would leave a stale figure behind. The element
        // itself survives, so observing its subtree is enough to recompute.
        try {
          var observer = new MutationObserver(function () {
            render(host);
          });
          observer.observe(host, { childList: true, subtree: true, characterData: true });
        } catch (e) {}
      }

      function init() {
        fetch('{{ routes.cart_url }}.js', {
          headers: { Accept: 'application/json' },
          credentials: 'same-origin'
        })
          .then(function (r) {
            return r.ok ? r.json() : null;
          })
          .then(function (c) {
            // Unreadable cart → no basis for a promise about checkout.
            if (!c || typeof c.item_count !== 'number') return;
            cart = c;
            start();
          })
          .catch(function () {
            /* fail closed: leave prices exactly as the theme rendered them */
          });
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', init);
      } else {
        init();
      }
    })();
  </script>
{%- endif -%}
