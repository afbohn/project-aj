{%- comment -%}
  The background-image layer for one Kitchen section. Renders nothing without an
  image, so a flat section keeps no wrapper and no stacking context.

  Decorative, so `alt` is empty and the layer is aria-hidden. Eager rather than
  lazy: a lazily-loaded background paints after the text has been read against
  the flat colour, which flashes.

  Usage, as the first child of .aj-kt: {% render 'aj-kitchen-bg', settings: section.settings %}
{%- endcomment -%}

{%- if settings.bg_image != blank -%}
  <span class="aj-kt__bg" aria-hidden="true">
    <img
      src="{{ settings.bg_image | image_url: width: 2000 }}"
      srcset="{{ settings.bg_image | image_url: width: 750 }} 750w,
              {{ settings.bg_image | image_url: width: 1100 }} 1100w,
              {{ settings.bg_image | image_url: width: 1500 }} 1500w,
              {{ settings.bg_image | image_url: width: 2000 }} 2000w"
      sizes="100vw"
      alt=""
      width="{{ settings.bg_image.width }}"
      height="{{ settings.bg_image.height }}"
      loading="eager"
    >
  </span>
{%- endif -%}
