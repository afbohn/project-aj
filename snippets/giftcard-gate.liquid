{%- comment -%}
  Gift card soft gate.
  Visitors must enter a valid single-use discount code to view the store.
  The code is validated by a Cloudflare Worker (settings.gate_worker_url); on
  success the browser is redirected through /discount/<code> so Shopify
  auto-applies the discount, and a flag is stored so the gate stays unlocked
  on this device until the code is used in a purchase (then it stops working).

  This is a SOFT gate: it hides the storefront from normal visitors but is not
  a server-side lock. The discount itself is always hard-enforced by Shopify.
{%- endcomment -%}
{%- if settings.gate_enabled and settings.gate_worker_url != blank -%}
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Montserrat:wght@400;600&display=swap" rel="stylesheet">
  <style>
    .txgc-gate{position:fixed;inset:0;z-index:2147483000;display:flex;align-items:center;justify-content:center;background:{{ settings.gate_bg_color }};padding:24px;font-family:'Montserrat',-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;color:{{ settings.gate_text_color }};}
    .txgc-gate__card{width:100%;max-width:420px;text-align:center;}
    .txgc-gate__logo{max-width:200px;margin:0 auto 1.75rem;display:block;}
    .txgc-gate__heading{font-family:'Bebas Neue',sans-serif;font-size:2.6rem;line-height:1.05;letter-spacing:.04em;margin:0 0 .5rem;color:{{ settings.gate_text_color }};}
    .txgc-gate__sub{font-size:1rem;opacity:.85;margin:0 0 1.5rem;color:{{ settings.gate_text_color }};}
    .txgc-gate__form{display:flex;flex-direction:column;gap:.75rem;}
    .txgc-gate__input{font-family:'Montserrat',sans-serif;padding:.85rem 1rem;font-size:1rem;border:1px solid rgba(255,255,255,.35);border-radius:8px;text-align:center;letter-spacing:.08em;text-transform:uppercase;background:#fff;color:#242f46;}
    .txgc-gate__btn{font-family:'Montserrat',sans-serif;font-weight:600;letter-spacing:.05em;text-transform:uppercase;padding:.85rem 1rem;font-size:1rem;border:0;border-radius:8px;cursor:pointer;background:{{ settings.gate_btn_color }};color:{{ settings.gate_btn_text_color }};}
    .txgc-gate__btn[disabled]{opacity:.6;cursor:progress;}
    .txgc-gate__error{color:#ffb3b3;min-height:1.2em;font-size:.9rem;margin:.25rem 0 0;}
    html.txgc-locked,body.txgc-locked{overflow:hidden !important;}
    html.txgc-locked #header-group,html.txgc-locked #MainContent,html.txgc-locked .content-for-layout,html.txgc-locked footer{display:none !important;}
  </style>
  <div class="txgc-gate" id="txgc-gate" role="dialog" aria-modal="true" aria-labelledby="txgc-gate-heading">
    <div class="txgc-gate__card">
      {%- liquid
        assign gate_logo_src = ''
        if settings.gate_logo != blank
          assign gate_logo_src = settings.gate_logo | image_url: width: 400
        elsif settings.gate_logo_url != blank
          assign gate_logo_src = settings.gate_logo_url
        endif
      -%}
      {%- if gate_logo_src != blank -%}
        <img class="txgc-gate__logo" src="{{ gate_logo_src }}" alt="Twisted X" loading="eager">
      {%- endif -%}
      <h1 class="txgc-gate__heading" id="txgc-gate-heading">{{ settings.gate_heading }}</h1>
      <p class="txgc-gate__sub">{{ settings.gate_subheading }}</p>
      <form class="txgc-gate__form" id="txgc-gate-form" autocomplete="off" novalidate>
        <input
          class="txgc-gate__input"
          id="txgc-gate-input"
          name="code"
          type="text"
          inputmode="text"
          autocapitalize="characters"
          autocomplete="off"
          spellcheck="false"
          placeholder="{{ settings.gate_placeholder }}"
          aria-label="{{ settings.gate_placeholder }}"
          required
        >
        <button class="txgc-gate__btn" id="txgc-gate-btn" type="submit">{{ settings.gate_button_label }}</button>
        <p class="txgc-gate__error" id="txgc-gate-error" role="alert" aria-live="polite"></p>
      </form>
    </div>
  </div>
  <script>
    (function () {
      var KEY = 'txgc_gate_code';
      var COLL_KEY = 'txgc_gate_collection';
      // Set only if the worker reports the code's value. The worker does not
      // return one today (it replies { valid, collection }); when it does, the
      // home page welcome section picks this up automatically.
      var VALUE_KEY = 'txgc_gate_value';
      // The code's gate config (giftcard/gate metafield, v1), as returned by
      // the worker: {v, type, rate, amount, freeShipping, wholeCart,
      // minSubtotal, collectionIds, collectionHandles}. Absent when the worker
      // could not read it, in which case the storefront shows normal prices.
      var CONFIG_KEY = 'txgc_gate_config';
      var WORKER = {{ settings.gate_worker_url | json }};
      var REDIRECT = {{ settings.gate_redirect_path | default: '/' | json }};
      var ERRMSG = {{ settings.gate_error | default: "That code isn't valid or has already been used. Please check and try again." | json }};
      var gate = document.getElementById('txgc-gate');

      function unlock() {
        if (gate && gate.parentNode) gate.parentNode.removeChild(gate);
        document.documentElement.classList.remove('txgc-locked');
        if (document.body) document.body.classList.remove('txgc-locked');
      }

      // Unlocked on this device? Re-validate the stored code on each load:
      // unlock immediately for speed, but if the code is no longer valid (e.g.
      // it was used in a purchase), clear it and reload so the gate returns.
      var storedCode = null;
      try { storedCode = localStorage.getItem(KEY); } catch (e) {}
      if (storedCode) {
        unlock();
        // Returning visitor landing on the homepage: if their code is scoped to
        // a collection, drop them on it (same as first entry). Only on the home
        // page ('/' or the localized root) so deep links and product/cart pages
        // are left alone — the gate runs on every page via the layout.
        var storedColl = null;
        try { storedColl = localStorage.getItem(COLL_KEY); } catch (e) {}
        if (storedColl && /^\/(?:[a-z]{2}(?:-[a-z]{2})?\/)?$/i.test(window.location.pathname)) {
          window.location.replace('/collections/' + storedColl);
          return;
        }
        fetch(WORKER, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ code: storedCode })
        })
          .then(function (r) { return r.json().catch(function () { return {}; }); })
          .then(function (d) {
            if (!d || !d.valid) {
              try {
                localStorage.removeItem(KEY);
                localStorage.removeItem(COLL_KEY);
                localStorage.removeItem(VALUE_KEY);
                localStorage.removeItem(CONFIG_KEY);
              } catch (e) {}
              window.location.reload();
            }
          })
          .catch(function () { /* network error: fail open, stay unlocked */ });
        return;
      }

      // Lock scroll + hide the storefront while the gate is shown.
      document.documentElement.classList.add('txgc-locked');

      // Physically remove the storefront content while locked, so deleting the
      // overlay in dev tools reveals nothing. Unlocking always triggers a full
      // page reload, so there is nothing to restore in place.
      function stripContent() {
        ['#header-group', '#MainContent', '.content-for-layout', 'footer'].forEach(function (sel) {
          var nodes = document.querySelectorAll(sel);
          for (var i = 0; i < nodes.length; i++) {
            if (nodes[i] && nodes[i].parentNode) nodes[i].parentNode.removeChild(nodes[i]);
          }
        });
      }

      document.addEventListener('DOMContentLoaded', function () {
        if (document.body) document.body.classList.add('txgc-locked');
        stripContent();
      });
      if (document.readyState !== 'loading') stripContent();

      var form = document.getElementById('txgc-gate-form');
      var input = document.getElementById('txgc-gate-input');
      var btn = document.getElementById('txgc-gate-btn');
      var errEl = document.getElementById('txgc-gate-error');

      if (!form) return;
      form.addEventListener('submit', function (ev) {
        ev.preventDefault();
        var code = (input.value || '').trim();
        if (!code) return;
        errEl.textContent = '';
        btn.disabled = true;
        fetch(WORKER, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ code: code })
        })
          .then(function (r) { return r.json().catch(function () { return {}; }); })
          .then(function (d) {
            if (d && d.valid) {
              try {
                localStorage.setItem(KEY, code);
                // Remember the collection so returning visitors can be sent
                // back to it from the homepage (see stored-code path above).
                if (d.collection) {
                  localStorage.setItem(COLL_KEY, d.collection);
                } else {
                  localStorage.removeItem(COLL_KEY);
                }
                if (d.value) {
                  localStorage.setItem(VALUE_KEY, d.value);
                } else {
                  localStorage.removeItem(VALUE_KEY);
                }
                if (d.gate) {
                  localStorage.setItem(CONFIG_KEY, JSON.stringify(d.gate));
                } else {
                  localStorage.removeItem(CONFIG_KEY);
                }
              } catch (e) {}
              // Let Shopify auto-apply the discount, then land the visitor on
              // the discount's collection when it's scoped to one; otherwise
              // fall back to the default redirect (home page).
              var dest = d.collection ? '/collections/' + d.collection : REDIRECT;
              window.location.assign('/discount/' + encodeURIComponent(code) + '?redirect=' + encodeURIComponent(dest));
            } else {
              errEl.textContent = ERRMSG;
              btn.disabled = false;
            }
          })
          .catch(function () {
            errEl.textContent = 'Something went wrong. Please try again.';
            btn.disabled = false;
          });
      });
    })();
  </script>
{%- endif -%}
