{% doc %}
  Renders a "X% claimed" progress bar for a daily deal, from real inventory.

  The math is deliberately honest and has no client-side animation or random
  seeding:

      claimed = units_allocated - (inventory still on hand)
      percent = claimed / units_allocated

  `units_allocated` is the merchant's own cap for the deal, set on the
  metaobject — not the supplier's total stock. That is the number that makes
  the claim truthful: we are saying "N units were set aside for this deal and
  this many are gone", which is a fact we can actually stand behind.

  Renders NOTHING when it cannot be truthful:
    * no allocation set
    * the product does not track inventory in Shopify (common for dropship /
      Collective items, where the supplier holds the stock)

  In those cases the caller falls back to whatever else it wants to show.

  @param {object} product - The deal product.
  @param {number} units_allocated - Units set aside for this deal.
  @param {number} [floor_percent] - Never display below this. Off by default;
    see the note in the section schema before turning it on.
{% enddoc %}

{%- liquid
  assign allocated = units_allocated | plus: 0
  assign tracked = false
  assign remaining = 0

  comment
    Sum across variants. A variant with inventory_management unset is untracked
    (Shopify reports inventory_quantity 0 for those, which would otherwise read
    as "sold out" and inflate the bar to 100%).
  endcomment
  for variant in product.variants
    if variant.inventory_management == 'shopify'
      assign tracked = true
      if variant.inventory_quantity > 0
        assign remaining = remaining | plus: variant.inventory_quantity
      endif
    endif
  endfor

  assign claimed = allocated | minus: remaining
  if claimed < 0
    comment
      On-hand exceeds the allocation — the allocation is stale or was raised.
      Report nothing sold rather than a negative bar.
    endcomment
    assign claimed = 0
  endif

  assign percent = 0
  if allocated > 0
    assign percent = claimed | times: 100 | divided_by: allocated
    if percent > 100
      assign percent = 100
    endif
  endif

  assign display_percent = percent
  if floor_percent and display_percent < floor_percent
    assign display_percent = floor_percent
  endif

  assign show = false
  if tracked and allocated > 0
    assign show = true
  endif
-%}

{%- if show -%}
  <div class="aj-claimed">
    <div
      class="aj-claimed__track"
      role="progressbar"
      aria-valuenow="{{ display_percent }}"
      aria-valuemin="0"
      aria-valuemax="100"
      aria-label="{{ display_percent }}% of this deal claimed"
    >
      <div class="aj-claimed__fill" style="width: {{ display_percent }}%;"></div>
    </div>
    <p class="aj-claimed__text">
      <strong>{{ display_percent }}% claimed</strong>
      {%- if remaining > 0 and remaining <= 25 -%}
        <span class="aj-claimed__remaining">Only {{ remaining }} left</span>
      {%- endif -%}
    </p>
  </div>
{%- endif -%}
