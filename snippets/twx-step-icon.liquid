{%- comment -%}
  TWX step icon.

  The theme's shared icon set (snippets/icon.liquid) has no cart, cash register
  or discount icon, and that file is Horizon's — editing it would put our custom
  paths in the way of any future theme update. So the few icons we need live
  here, and anything else falls through to the theme set unchanged.

  Custom names: cart-add, register, discount-tag
  Anything else is passed to snippets/icon.liquid verbatim.

  Renders paths only — call it inside an <svg viewBox="0 0 20 20">, same as
  'icon'. Custom paths declare fill/stroke explicitly so they render correctly
  under the caller's `fill: currentColor`.

  @param {string} icon - icon name
{%- endcomment -%}

{%- case icon -%}
  {%- when 'cart-add' -%}
    {%- comment -%} Arrow dropping into a shopping cart. {%- endcomment -%}
    <path
      d="M10 1.75V6.4M7.7 4.2L10 6.5L12.3 4.2"
      fill="none"
      stroke="currentColor"
      stroke-width="1.5"
      stroke-linecap="round"
      stroke-linejoin="round"
    />
    <path
      d="M1.9 4.9h1.75a0.9 0.9 0 0 1 0.87 0.68l2.1 8.02h7.9l1.72-5.4H6.2"
      fill="none"
      stroke="currentColor"
      stroke-width="1.5"
      stroke-linecap="round"
      stroke-linejoin="round"
    />
    <circle cx="8" cy="17.1" r="1.15" fill="currentColor" />
    <circle cx="13.6" cy="17.1" r="1.15" fill="currentColor" />

  {%- when 'register' -%}
    {%- comment -%} Cash register: raised display, body, keys, base. {%- endcomment -%}
    <path
      d="M6.6 3.4h7a0.8 0.8 0 0 1 0.8 0.8v3.2H5.8V4.2a0.8 0.8 0 0 1 0.8-0.8Z"
      fill="none"
      stroke="currentColor"
      stroke-width="1.4"
      stroke-linejoin="round"
    />
    <path
      d="M4.3 7.4h11.4a0.9 0.9 0 0 1 0.9 0.9v6H3.4v-6a0.9 0.9 0 0 1 0.9-0.9Z"
      fill="none"
      stroke="currentColor"
      stroke-width="1.4"
      stroke-linejoin="round"
    />
    <path
      d="M2.3 14.3h15.4v2.3H2.3z"
      fill="none"
      stroke="currentColor"
      stroke-width="1.4"
      stroke-linejoin="round"
    />
    <path
      d="M6.2 10.2h2.1M11.7 10.2h2.1M6.2 12.3h2.1M11.7 12.3h2.1"
      fill="none"
      stroke="currentColor"
      stroke-width="1.3"
      stroke-linecap="round"
    />

  {%- when 'discount-tag' -%}
    {%- comment -%} Price tag with a percent sign. {%- endcomment -%}
    <path
      d="M10.55 2.4h5.05a1 1 0 0 1 1 1v5.05a1 1 0 0 1-.29.71l-7.15 7.15a1 1 0 0 1-1.42 0L2.69 10.3a1 1 0 0 1 0-1.42l7.15-7.15a1 1 0 0 1 .71-.29Z"
      fill="none"
      stroke="currentColor"
      stroke-width="1.4"
      stroke-linejoin="round"
    />
    <circle cx="13.6" cy="6.4" r="1.15" fill="currentColor" />
    <path
      d="M11.9 9.5L8.2 13.2"
      fill="none"
      stroke="currentColor"
      stroke-width="1.4"
      stroke-linecap="round"
    />
    <circle cx="8.4" cy="9.7" r="0.95" fill="currentColor" />
    <circle cx="11.7" cy="13" r="0.95" fill="currentColor" />

  {%- else -%}
    {%- render 'icon', icon: icon -%}
{%- endcase -%}
